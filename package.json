{
  "name": "utube",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "cf-typegen": "turbo run cf-typegen"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "catalog:tooling",
    "alchemy": "catalog:alchemy",
    "effect": "catalog:effect",
    "@cloudflare/workers-types": "catalog:alchemy",
    "@effect/platform-bun": "catalog:effect",
    "@effect/platform-node": "catalog:effect"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "zod": "^4.3.6"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.117"
  },
  "catalogs": {
    "elysia": {
      "elysia": "^1.4.30",
      "@elysia/eden": "^1.4.10",
      "@elysiajs/cors": "^1.4.1"
    },
    "react": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0"
    },
    "effect": {
      "effect": "4.0.0-rc.117",
      "@effect/platform-bun": "4.0.0-rc.117",
      "@effect/platform-node": "4.0.0-rc.117",
      "@effect/platform-node-shared": "4.0.0-rc.117",
      "@effect/sql-pg": "4.0.0-rc.117"
    },
    "alchemy": {
      "alchemy": "2.0.0-beta.79",
      "@cloudflare/workers-types": "4.20260603.1"
    },
    "drizzle": {
      "drizzle-kit": "1.0.0-rc.5-5935859",
      "drizzle-orm": "1.0.0-rc.5-5935859"
    },
    "tooling": {
      "typescript": "^7.0.2",
      "@types/node": "^22.19.11",
      "@types/bun": "^1.4.2"
    },
    "tailwind": {
      "@tailwindcss/vite": "^4.3.3",
      "tailwindcss": "^4.3.3",
      "tailwind-merge": "^3.7.0",
      "tw-animate-css": "^1.4.0"
    },
    "ui": {
      "clsx": "^2.1.1",
      "@base-ui/react": "^1.8.0",
      "class-variance-authority": "^0.7.1"
    }
  }
}
