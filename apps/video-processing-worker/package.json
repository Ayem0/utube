{
  "name": "@repo/video-processing-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev -c bridge_src/wrangler.jsonc -c wrangler.jsonc --port 8788 --inspector-port 9230 --persist-to ../../.cloudflare-dev",
    "cf-typegen": "wrangler types -c wrangler.jsonc -c ../ws/wrangler.jsonc",
    "build": "bun build ./container_src/index.ts --target=bun --outfile=dist/index.mjs"
  },
  "dependencies": {
    "@repo/services": "workspace:*",
    "@repo/types": "workspace:*",
    "effect": "catalog:effect",
    "zod": "catalog:",
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:tooling"
  }
}
